# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (real sign-in + database) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only; used by `npm run seed`. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional sign-in providers (must match what is enabled in Supabase) ---
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_PHONE_ENABLED=false

# --- Offline demo only (no Supabase). Never enable in a real deployment. ---
# ALLOW_DEV_FALLBACK=true
# Required (16+ random characters) if the dev fallback is ever run with NODE_ENV=production.
# DEV_SESSION_SECRET=
